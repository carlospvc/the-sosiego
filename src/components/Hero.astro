---
// Home hero — full-screen background video, one Tanker headline, whisper line.
---

<section class="hero" id="top" data-screen-label="Hero">
  <video
    class="hero-bg"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster="/assets/Sosiego_patio_hero.png"
  >
    <source src="/assets/sosiego_hero.mp4" type="video/mp4" />
  </video>
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="wrap hero-inner">
    <h1 class="hero-title">
      THINGS<br />WORTH<br />YOUR TIME<span class="dot">.</span>
    </h1>
  </div>
  <div class="hero-cap">
    <div class="wrap">
      <p>There's a Spanish word for the calm you feel when nothing is pulling at you.</p>
    </div>
  </div>
</section>
