---
// Who page hero — full-bleed background video (square corners). The fixed
// header sits over its top; a soft top scrim keeps the light header legible.
---

<figure class="who-hero">
  <video
    class="who-hero-vid"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster="/assets/desk.jpg"
  >
    <source src="/assets/workspace.mp4" type="video/mp4" />
  </video>
</figure>
