---
// Work — id #making. Two project cases (Circles, Coaching OS). The Circles
// card links out to the live site (thisiscircles.com); Coaching OS stays an
// inert placeholder (href="#") until its URL is provided.
---

<section class="making" id="making" data-screen-label="Work">
  <div class="wrap">
    <p class="making-label reveal">Work</p>

    <figure class="case reveal">
      <a class="case-frame" href="https://thisiscircles.com" target="_blank" rel="noopener">
        <img
          class="case-img"
          src="/assets/circles-diptych.png"
          alt="Circles — an app for staying close to the people you care about"
        />
        <span class="case-hover" aria-hidden="true">
          <span class="case-view">View the project <span class="arw">→</span></span>
        </span>
      </a>
      <figcaption class="case-cap">
        <a class="case-view touch" href="https://thisiscircles.com" target="_blank" rel="noopener">View the project <span class="arw">→</span></a>
      </figcaption>
    </figure>

    <figure class="case reveal">
      <a class="case-frame" href="#" data-inert>
        <img
          class="case-img"
          src="/assets/coaches-diptych.png"
          alt="A quiet space for coaches — Coaching OS"
        />
        <span class="case-hover" aria-hidden="true">
          <span class="case-view">View the project <span class="arw">→</span></span>
        </span>
      </a>
      <figcaption class="case-cap">
        <span class="work-status">In private beta</span>
        <span class="case-view touch">View the project <span class="arw">→</span></span>
      </figcaption>
    </figure>
  </div>
</section>
